# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (no trailing slash) – used for canonical URLs, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details (leave blank to hide)
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Digits only with country code, e.g. 91XXXXXXXXXX. WhatsApp button shows only when set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics + Search Console (leave blank to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form email delivery via Resend (server-only secrets, never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=JoySky <onboarding@resend.dev>
